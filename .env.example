# Frontend Supabase Configuration (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-Side / Supabase Edge Functions Secrets
# Note: DO NOT set OPENAI_API_KEY in frontend .env
# Configure OPENAI_API_KEY and OPENAI_MODEL in Supabase Edge Function Secrets:
# supabase secrets set OPENAI_API_KEY=sk-... OPENAI_MODEL=gpt-4o-mini
